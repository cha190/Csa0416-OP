#include <stdio.h>

struct Process {
    int pid;        // Process ID
    int burst_time; // Execution time
    int priority;   // Priority (Lower number = Higher priority)
    int wait_time;  // Waiting time
    int tat;        // Turnaround time
};

int main() {
    int n, i, j;
    float total_wait_time = 0, total_tat = 0;

    printf("--- Non-Preemptive Priority Scheduling ---\n");
    printf("Enter the number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    // Input burst time and priority for each process
    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d:\n", p[i].pid);
        printf("  Enter Burst Time: ");
        scanf("%d", &p[i].burst_time);
        printf("  Enter Priority (lower number = higher priority): ");
        scanf("%d", &p[i].priority);
    }

    // Sort processes by priority in ascending order (Bubble Sort)
    struct Process temp;
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (p[j].priority > p[j + 1].priority) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    // Calculate waiting time and turnaround time
    p[0].wait_time = 0; // First executing process has 0 waiting time
    p[0].tat = p[0].burst_time;

    for (i = 1; i < n; i++) {
        // Waiting time of current process = Burst time of previous process + Waiting time of previous process
        p[i].wait_time = p[i - 1].wait_time + p[i - 1].burst_time;
        
        // Turnaround time = Waiting time + Burst time
        p[i].tat = p[i].wait_time + p[i].burst_time;
    }

    // Display the results in a formatted table
    printf("\nProcess\t\tPriority\tBurst Time\tWaiting Time\tTurnaround Time\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t\t%d\t\t%d\t\t%d\t\t%d\n", p[i].pid, p[i].priority, p[i].burst_time, p[i].wait_time, p[i].tat);
        total_wait_time += p[i].wait_time;
        total_tat += p[i].tat;
    }

    // Display average metrics
    printf("\nAverage Waiting Time: %.2f", total_wait_time / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);

    return 0;
}
