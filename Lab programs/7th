#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <errno.h>

#define BUFFER_SIZE 4096

int main(int argc, char *argv[]) {
    int fd_in, fd_out;
    ssize_t n_read, n_write;
    char buffer[BUFFER_SIZE];

    // Check for correct command-line arguments
    if (argc != 3) {
        fprintf(stderr, "Usage: %s <source_file> <destination_file>\n", argv[0]);
        exit(EXIT_FAILURE);
    }

    // 1. Open source file in read-only mode
    fd_in = open(argv[1], O_RDONLY);
    if (fd_in == -1) {
        perror("Error opening source file");
        exit(EXIT_FAILURE);
    }

    // 2. Open/Create destination file in write-only mode
    // O_CREAT: Create file if it doesn't exist
    // O_TRUNC: Empty the file if it already exists
    // 0644: Permissions (Read/Write for owner, Read-only for group/others)
    fd_out = open(argv[2], O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd_out == -1) {
        perror("Error opening/creating destination file");
        close(fd_in);
        exit(EXIT_FAILURE);
    }

    // 3. Read from source and write to destination in chunks
    while ((n_read = read(fd_in, buffer, BUFFER_SIZE)) > 0) {
        n_write = write(fd_out, buffer, n_read);
        if (n_write != n_read) {
            perror("Error writing to destination file");
            close(fd_in);
            close(fd_out);
            exit(EXIT_FAILURE);
        }
    }

    if (n_read == -1) {
        perror("Error reading from source file");
    }

    // 4. Close both file descriptors
    close(fd_in);
    close(fd_out);

    printf("File copied successfully using system calls.\n");
    return EXIT_SUCCESS;
}
