#include <stdio.h>

struct Process {
    int pid;          // Process ID
    int arrival_time; // Arrival time
    int burst_time;   // Burst time
    int rem_time;     // Remaining burst time
    int wait_time;    // Waiting time
    int tat;          // Turnaround time
    int completed;    // Completion flag
};

int main() {
    int n, time_quantum, i, time = 0, completed_count = 0;
    float total_wait_time = 0, total_tat = 0;

    printf("--- Round Robin Scheduling Algorithm ---\n");
    printf("Enter the number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    // Input arrival time and burst time for each process
    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d:\n", p[i].pid);
        printf("  Enter Arrival Time: ");
        scanf("%d", &p[i].arrival_time);
        printf("  Enter Burst Time: ");
        scanf("%d", &p[i].burst_time);
        p[i].rem_time = p[i].burst_time;
        p[i].completed = 0;
    }

    printf("\nEnter Time Quantum: ");
    scanf("%d", &time_quantum);

    // Queue simulation using a simple ready queue approach
    int queue[100], front = 0, rear = 0;
    int visited[n];
    for (i = 0; i < n; i++) visited[i] = 0;

    // Find the first arriving process(es) and push to queue
    // To simplify, sort processes by arrival time or handle them dynamically:
    // Here we use a standard round-robin ready queue scanning approach:
    
    // Sort processes by arrival time initially for smooth queue feeding
    struct Process temp;
    for (i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (p[j].arrival_time > p[j + 1].arrival_time) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    // Push the first process that arrives at or before time 0
    time = p[0].arrival_time;
    queue[rear++] = 0;
    visited[0] = 1;

    while (front < rear) {
        int idx = queue[front++];

        // Execute process for time quantum or its remaining time
        if (p[idx].rem_time > time_quantum) {
            time += time_quantum;
            p[idx].rem_time -= time_quantum;
        } else {
            time += p[idx].rem_time;
            p[idx].rem_time = 0;
            p[idx].completed = 1;

            p[idx].tat = time - p[idx].arrival_time;
            p[idx].wait_time = p[idx].tat - p[idx].burst_time;

            total_wait_time += p[idx].wait_time;
            total_tat += p[idx].tat;
            completed_count++;
        }

        // Check for any newly arrived processes during this execution window and add to queue
        for (i = 0; i < n; i++) {
            if (p[i].arrival_time <= time && visited[i] == 0 && p[i].completed == 0) {
                queue[rear++] = i;
                visited[i] = 1;
            }
        }

        // If the current process is not finished, re-add it to the back of the queue
        if (p[idx].completed == 0) {
            queue[rear++] = idx;
        }

        // If queue becomes empty but processes remain (CPU idle state), advance time to next arrival
        if (front == rear && completed_count < n) {
            for (i = 0; i < n; i++) {
                if (p[i].completed == 0) {
                    time = p[i].arrival_time;
                    queue[rear++] = i;
                    visited[i] = 1;
                    break;
                }
            }
        }
    }

    // Display results in a formatted table
    printf("\nProcess\tArrival\tBurst\tWaiting\tTurnaround\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\n", 
               p[i].pid, p[i].arrival_time, p[i].burst_time, 
               p[i].wait_time, p[i].tat);
    }

    // Display average metrics
    printf("\nAverage Waiting Time: %.2f", total_wait_time / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);

    return 0;
}
