#include <stdio.h>

struct Process {
    int pid;        // Process ID
    int burst_time; // Execution time
    int priority;   // Priority (Lower number = Higher priority)
    int arrival_time; // Arrival time
    int rem_time;   // Remaining burst time
    int wait_time;  // Waiting time
    int tat;        // Turnaround time
    int completed;  // Completion status
};

int main() {
    int n, i, time = 0, completed_count = 0;
    float total_wait_time = 0, total_tat = 0;

    printf("--- Preemptive Priority Scheduling ---\n");
    printf("Enter the number of processes: ");
    scanf("%d", &n);

    struct Process p[n];

    // Input arrival time, burst time, and priority for each process
    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("\nProcess P%d:\n", p[i].pid);
        printf("  Enter Arrival Time: ");
        scanf("%d", &p[i].arrival_time);
        printf("  Enter Burst Time: ");
        scanf("%d", &p[i].burst_time);
        printf("  Enter Priority (lower number = higher priority): ");
        scanf("%d", &p[i].priority);
        
        p[i].rem_time = p[i].burst_time;
        p[i].completed = 0;
    }

    // Scheduling loop
    while (completed_count < n) {
        int highest_priority = 9999;
        int selected_index = -1;

        // Find the process with the highest priority (lowest value) among arrived, uncompleted processes
        for (i = 0; i < n; i++) {
            if (p[i].arrival_time <= time && p[i].completed == 0) {
                if (p[i].priority < highest_priority) {
                    highest_priority = p[i].priority;
                    selected_index = i;
                }
            }
        }

        // If no process has arrived yet, CPU stays idle
        if (selected_index == -1) {
            time++;
            continue;
        }

        // Execute the selected process for 1 unit of time
        p[selected_index].rem_time--;
        time++;

        // If the process finishes execution
        if (p[selected_index].rem_time == 0) {
            p[selected_index].completed = 1;
            completed_count++;

            // Turnaround Time = Completion Time - Arrival Time
            p[selected_index].tat = time - p[selected_index].arrival_time;
            
            // Waiting Time = Turnaround Time - Burst Time
            p[selected_index].wait_time = p[selected_index].tat - p[selected_index].burst_time;
            
            total_wait_time += p[selected_index].wait_time;
            total_tat += p[selected_index].tat;
        }
    }

    // Display the results in a formatted table
    printf("\nProcess\tArrival\tBurst\tPriority\tWaiting\tTurnaround\n");
    for (i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t\t%d\t%d\n", 
               p[i].pid, p[i].arrival_time, p[i].burst_time, 
               p[i].priority, p[i].wait_time, p[i].tat);
    }

    // Display average metrics
    printf("\nAverage Waiting Time: %.2f", total_wait_time / n);
    printf("\nAverage Turnaround Time: %.2f\n", total_tat / n);

    return 0;
}
